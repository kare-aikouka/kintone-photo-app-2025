- weekdays = %w[日 月 火 水 木 金 土]
- index_return_params = { machine: @machine_name.presence, machine_model: params[:machine_model].presence }.compact_blank
- photo_link_params = index_return_params.merge(date: @selected_filter.presence || @selected_date).compact_blank
= javascript_include_tag "photo_status", defer: true

.photo-page
  .photo-header
    .photo-title
      = link_to "← 施工機一覧", machines_path
      %span.machine-title= display_machine_name(@machine_name).presence || "施工機未指定"
    .photo-header-meta
      %span.header-badge= "#{@default_records.count}件"
      %span.header-badge= "未完了 #{@incomplete_records.count}件"

  - if @photo_error
    .alert.alert-danger.photo-alert
      %strong 写真・物件情報を取得できませんでした。
      %pre= "#{@photo_error.class}: #{@photo_error.message}"

  - if flash[:notice].present?
    .alert.alert-success.photo-alert= flash[:notice]
  - if flash[:alert].present?
    .alert.alert-danger.photo-alert= flash[:alert]

  .photo-date-tabs
    - @date_tabs.each do |date|
      - count = @records_by_date.fetch(date, []).count
      - incomplete_count = @records_by_date.fetch(date, []).count { |record| incomplete?(record) }
      - active = !%w[all completed hidden].include?(@selected_filter) && date == @selected_date
      = link_to photos_path(index_return_params.merge(date: date)), class: "photo-date-tab #{'active' if active}" do
        %span= "#{date.month}/#{date.day} #{weekdays[date.wday]}"
        .photo-tab-badges
          %strong= count
          - if active
            %strong= incomplete_count
    - if @future_records_enabled
      = link_to photos_path(index_return_params.merge(date: "all")), class: "photo-date-tab #{'active' if @selected_filter == 'all'}" do
        %span 全て
        .photo-tab-badges
          %strong= @future_records.count
          %strong= @future_incomplete_count
    = link_to photos_path(index_return_params.merge(date: "completed")), class: "photo-date-tab photo-date-tab-completed #{'active' if @selected_filter == 'completed'}" do
      %span 完了分
      .photo-tab-badges
        %strong= @completed_records.count
    = link_to photos_path(index_return_params.merge(date: "hidden")), class: "photo-date-tab #{'active' if @selected_filter == 'hidden'}" do
      %span 非表示
      .photo-tab-badges
        %strong= @hidden_records.count

  - if @selected_records.present?
    .photo-records
      - @selected_records.each do |record|
        - notes = record_notes(record)
        .photo-record
          .photo-record-main
            .photo-record-date
              = field_value(record, :date) || @selected_date
            = render "record_information", record: record
            .photo-record-actions
              - if record_id(record).present?
                = link_to "地図", map_photo_path(record_id(record), photo_link_params.merge(from: "index")), class: "btn btn-map-action"
              - else
                = link_to "地図", "javascript:undefined", class: "btn btn-map-action disabled"
              = link_to "図面", "javascript:undefined", class: "btn btn-soft disabled"
              - if record_id(record).present?
                = link_to "写真", photo_path(record_id(record), photo_link_params), class: "btn btn-primary-action"
                = link_to "資料UP", documents_photo_path(record_id(record), photo_link_params), class: "btn btn-document-action"
              - else
                = link_to "写真", "javascript:undefined", class: "btn btn-primary-action disabled"
                = link_to "資料UP", "javascript:undefined", class: "btn btn-document-action disabled"
          .photo-record-status{ class: ("has-notes" if notes.present?) }
            %span.photo-status-line
              写真：
              %strong{ class: ("is-done" if photo_status(record) == PhotosController::PICTURE_FLAG_DONE) }= photo_status(record)
            = render "record_notes", notes: notes
            - if record_id(record).present? && photo_visibility_change_available?(record)
              %button.photo-status-switch.js-photo-status-switch{ type: "button", data: { update_url: visibility_photo_path(record_id(record), photo_link_params), visibility_action: photo_app_hidden?(record) ? "show" : "hide" } }= photo_app_hidden?(record) ? "一覧に戻す" : "フラグ変更"
  - else
    .alert.alert-info.photo-alert
      = @selected_filter == "hidden" ? "非表示にした物件はありません。" : "#{display_machine_name(@machine_name)} に紐づく物件レコードが見つかりませんでした。"

  - if show_debug_panels? && @field_keys.present?
    %details.photo-debug
      %summary 取得フィールド確認
      %p
        %strong フィールド:
        = @field_keys.join(", ")
      - if @field_preview.present?
        %table
          %tbody
            - @field_preview.first(30).each do |key, value|
              %tr
                %th= key
                %td= value

%dialog.photo-status-dialog.js-photo-status-dialog{ "aria-labelledby" => "photo-status-dialog-title" }
  %header
    %h2#photo-status-dialog-title この物件をアプリの一覧から非表示にしますか？
    %button.photo-status-dialog-close.js-photo-status-dialog-close{ type: "button", title: "閉じる", "aria-label" => "閉じる" } ×
  %p 写真完了フラグは変更されません。
  = form_with url: photos_path, method: :patch, authenticity_token: form_authenticity_token, local: true, html: { class: "js-photo-status-form", data: { turbo: false } } do
    %button{ type: "submit", name: "visibility", value: "hide" } 一覧から非表示にする
    %button.photo-status-dialog-back{ type: "button" } 戻る
